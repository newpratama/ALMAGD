---
import NjdCafePage from '../../../../templates/NjdCafePage.astro';
import type { Locale } from '../../../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ar' } },
  ];
}

const { locale } = Astro.params;
---

<NjdCafePage locale={locale as Locale} />
