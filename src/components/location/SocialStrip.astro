---
import Icon from '../primitives/Icon.astro';
import type { Locale } from '../../lib/i18n';

interface SocialLink {
  platform: string;
  url: string;
  handle: string;
}

interface Props {
  socials: SocialLink[];
  venueName: string;
  locale: Locale;
}

const { socials = [], venueName, locale } = Astro.props;

const title = {
  id: `Media Sosial ${venueName}`,
  en: `${venueName} Social Media`,
  ar: `حسابات التواصل لـ ${venueName}`,
}[locale];
---

{socials.length > 0 && (
  <div class="social-strip">
    <span class="social-label">{title}:</span>
    <div class="social-links">
      {socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link-btn"
          aria-label={`${s.platform} ${s.handle}`}
        >
          <span class="social-icon" aria-hidden="true">
            <Icon name={s.platform} size={16} />
          </span>
          <span class="social-platform-name">{s.platform}</span>
          <span class="social-handle" dir="ltr">{s.handle}</span>
          <Icon name="external" size={14} />
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .social-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .social-label {
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-pine);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .social-link-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-mist);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-size: var(--font-size-caption);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .social-link-btn:hover {
    background-color: var(--color-stone);
    border-color: var(--color-brass-300);
    color: var(--color-pine);
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-pine);
  }

  .social-platform-name {
    text-transform: capitalize;
    color: var(--color-pine);
    font-weight: 600;
  }

  .social-handle {
    color: var(--color-muted);
  }
</style>
