---
import Icon from '../primitives/Icon.astro';
import { type Locale } from '../../lib/i18n';
import { type VenueKey, buildWhatsAppLink } from '../../lib/whatsapp';

interface Props {
  venueKey?: VenueKey;
  locale: Locale;
}

const { venueKey, locale } = Astro.props;

const directLink = venueKey ? buildWhatsAppLink({ venue: venueKey, locale }) : null;

const ariaLabel = {
  id: 'Hubungi via WhatsApp',
  en: 'Chat on WhatsApp',
  ar: 'تواصلوا عبر واتساب',
}[locale];
---

<div class="floating-wa-container">
  {
    directLink ? (
      <a
        href={directLink}
        target="_blank"
        rel="noopener"
        class="floating-wa-btn"
        aria-label={ariaLabel}
      >
        <Icon name="whatsapp" size={28} />
      </a>
    ) : (
      <button
        type="button"
        class="floating-wa-btn"
        aria-label={ariaLabel}
        id="floating-wa-trigger"
      >
        <Icon name="whatsapp" size={28} />
      </button>
    )
  }
</div>

<script>
  function setupFloatingTrigger() {
    const btn = document.getElementById('floating-wa-trigger');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-whatsapp-chooser'));
    });
  }
  document.addEventListener('DOMContentLoaded', setupFloatingTrigger);
</script>

<style>
  .floating-wa-container {
    position: fixed;
    inset-inline-end: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 900;
  }

  .floating-wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background-color: var(--color-wa);
    color: var(--color-wa-text);
    box-shadow: var(--shadow-2);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .floating-wa-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.4);
  }

  /* Hidden on mobile when sticky booking bar exists */
  :global(.has-sticky-bar) .floating-wa-container {
    display: none;
  }
  @media (min-width: 1024px) {
    :global(.has-sticky-bar) .floating-wa-container {
      display: block;
    }
  }
</style>
