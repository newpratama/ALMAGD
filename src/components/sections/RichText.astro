---
import Container from '../primitives/Container.astro';

interface Props {
  class?: string;
  size?: 'normal' | 'narrow';
}

const { class: className = '', size = 'narrow' } = Astro.props;
---

<div class:list={['rich-text-wrapper', className]}>
  <Container size={size}>
    <div class="rich-text-content">
      <slot />
    </div>
  </Container>
</div>

<style>
  .rich-text-wrapper {
    padding-block: var(--space-8);
  }

  .rich-text-content {
    max-width: 68ch;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink);
  }

  .rich-text-content :global(h2) {
    font-size: var(--font-size-h2);
    margin-block-start: var(--space-7);
    margin-block-end: var(--space-3);
  }

  .rich-text-content :global(h3) {
    font-size: var(--font-size-h3);
    margin-block-start: var(--space-6);
    margin-block-end: var(--space-2);
  }

  .rich-text-content :global(p) {
    margin-block-end: var(--space-4);
  }

  .rich-text-content :global(ul),
  .rich-text-content :global(ol) {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-5);
  }

  .rich-text-content :global(li) {
    margin-block-end: var(--space-2);
  }

  .rich-text-content :global(a) {
    color: var(--color-brass-text);
    text-decoration: underline;
    font-weight: 500;
  }

  .rich-text-content :global(blockquote) {
    border-inline-start: 4px solid var(--color-brass);
    padding-inline-start: var(--space-4);
    font-style: italic;
    color: var(--color-muted);
    margin-block: var(--space-5);
  }
</style>
