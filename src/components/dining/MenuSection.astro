---
import MenuItemRow from './MenuItemRow.astro';
import type { Locale } from '../../lib/i18n';

interface Category {
  id: string;
  slug: string;
  name: Record<Locale, string>;
  sortOrder: number;
}

interface MenuItem {
  id: string;
  slug: string;
  name: string;
  altName?: Record<Locale, string>;
  categoryId: string;
  price?: number | null;
  currency?: string;
  status: string;
}

interface Props {
  category: Category;
  items: MenuItem[];
  locale: Locale;
}

const { category, items, locale } = Astro.props;

const title = category.name[locale] || category.name.en || category.name.id;
---

{items.length > 0 && (
  <section class="menu-category-section" id={category.slug} aria-labelledby={`title-${category.slug}`}>
    <header class="category-header">
      <h2 id={`title-${category.slug}`} class="category-title">{title}</h2>
      <span class="category-count">({items.length})</span>
    </header>

    <div class="category-items-grid">
      {items.map((item) => (
        <MenuItemRow item={item} locale={locale} />
      ))}
    </div>
  </section>
)}

<style>
  .menu-category-section {
    scroll-margin-top: 110px;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-stone);
  }

  .menu-category-section:last-of-type {
    border-bottom: none;
  }

  .category-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-pine);
  }

  .category-title {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    color: var(--color-pine);
    margin: 0;
  }

  .category-count {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    font-weight: 500;
  }

  .category-items-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-6);
  }

  @media (min-width: 768px) {
    .category-items-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
