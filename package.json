{
  "name": "almagd-hospitality",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:admin": "npm --prefix admin run build",
    "build": "npm --prefix admin install && ASTRO_TELEMETRY_DISABLED=1 astro build && npm --prefix admin run build && mkdir -p dist/admin && cp -r admin/dist/* dist/admin/",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "astro check",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "astro": "^4.16.18"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
